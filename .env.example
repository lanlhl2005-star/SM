# Copy to .env and adjust for your PC. UNC works when the share is reachable;
# mapped drive letters (e.g. S:\...) also work on Windows.

# Optional overrides (default UNC paths are in config/default.json):
# PHOTO_BACKUP_ROOT=\\Server\Share\Sang\project\new project 2026\cmi 火炭 MVAC\Group_photo_backup
# SITE_MEMO_ROOT=\\Server\Share\Sang\project\new project 2026\cmi 火炭 MVAC\Site Memo

# Use repo mock folders when the live share is unavailable (cloud / offline):
USE_MOCK=true

# HOST=127.0.0.1
# PORT=3847

# --- WhatsApp Baileys linked-device photo backup (PRIMARY) ---
# Run on a Windows PC only. Do NOT scan QR from a cloud agent.
# npm run wa-link   → pair once (spare Linked devices slot)
# npm run wa-backup → daemon; saves into PHOTO_BACKUP_ROOT\<group>\YYYY-MM-DD\
#
# Auth credentials live under .wa-auth\ (gitignored). Never commit or sync them.
# WA_AUTH_DIR=.wa-auth
# WA_BACKUP_STATE_FILE=.wa-backup-state.json
# WA_BACKUP_HEARTBEAT=.wa-backup-heartbeat.json
# WA_FALLBACK_GROUP=unmapped
# WA_LINK_PHONE=85291234567
# WA_BACKUP_TZ=Asia/Hong_Kong

# --- WhatsApp Desktop media watcher (OPTIONAL / DEPRECATED fallback) ---
# Fragile when the Desktop media cache path is missing. Prefer wa-backup above.
# npm run backup-watch
#
# Typical Windows Store WhatsApp Desktop media cache:
# WA_DESKTOP_MEDIA_ROOT=%LOCALAPPDATA%\Packages\5319275A.WhatsAppDesktop_cv1g1gvanyjgm\LocalState\shared\transfers
#
# When USE_MOCK=true and WA_DESKTOP_MEDIA_ROOT is unset, watches:
#   mock/WhatsAppDesktop/media/
#
# WA_WATCH_POLL_MS=5000
# WA_WATCH_STABLE_MS=1500
# WA_WATCH_STATE_FILE=.backup-watch-state.json
