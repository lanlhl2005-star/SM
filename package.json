{
  "name": "site-memo",
  "version": "0.2.0",
  "private": true,
  "description": "LK-P01043 Site Memo: WhatsApp photo pick/caption → Draft editable .doc",
  "type": "module",
  "scripts": {
    "start": "node scripts/run-with-unc.mjs src/server.js",
    "dev": "node scripts/run-with-unc.mjs --watch src/server.js",
    "tunnel": "npx --yes cloudflared tunnel --url http://127.0.0.1:3847",
    "draft": "node scripts/run-with-unc.mjs src/cli-draft.js",
    "wa-link": "node scripts/run-with-unc.mjs src/wa-backup/index.js link",
    "wa-backup": "node scripts/run-with-unc.mjs src/wa-backup/index.js run",
    "wa-backup:health": "node scripts/run-with-unc.mjs src/wa-backup/index.js health",
    "backup-watch": "node scripts/run-with-unc.mjs src/backup-watch.js",
    "backup-watch:once": "node scripts/run-with-unc.mjs src/backup-watch.js --once",
    "postinstall": "node scripts/patch-baileys-json-imports.mjs",
    "check:auth": "node scripts/check-draft-ui-auth.mjs",
    "test": "node --import ./scripts/env-mock.mjs --test test/**/*.test.js",
    "smoke": "node --import ./scripts/env-mock.mjs src/cli-draft.js --subject \"Smoke test chilled water notice\" --short \"chilled water notice\" --intro \"Refer to site inspection, please note the following.\" --bullet \"Temporary storage area at L1\" --image site-memo/2026-11-18/IMG_chiller_plant.jpg --caption \"Photo of 14/F Chiller Plant\" --image site-memo/2026-11-18/IMG_cooling_tower.jpg --caption \"Photo of R/F Cooling Tower Area (Low Zone)\"",
    "smoke:backup": "node --import ./scripts/env-mock.mjs src/backup-watch.js --once"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "@whiskeysockets/baileys": "6.7.22",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
